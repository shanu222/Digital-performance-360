# ---- Runtime ----
NODE_ENV=development
PORT=8080
# Railway injects DATABASE_URL automatically when you reference the Postgres service
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dp360
DATABASE_SSL=false
# Exact origin of the Vercel frontend (comma-separate extra origins, e.g. preview domains)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# ---- Private administrator (seeded on first boot; change password after first login) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase
ADMIN_NAME=Administrator

# ---- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/callback

# ---- Google Play Developer Reporting (service account JSON, base64-encoded) ----
# Optional here: can also be uploaded from Integrations page (stored encrypted)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=

# ---- Secrets ----
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Any long random string
SESSION_SECRET=

# ---- AI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Email (provider: resend | smtp | none) ----
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Digital Performance 360 <reports@yourdomain.com>
EMAIL_TO=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Defaults ----
APP_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=USD
# Set to "true" only on the worker service if you run API and worker separately
RUN_SCHEDULER_IN_API=false
LOG_LEVEL=info
